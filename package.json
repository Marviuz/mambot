{
  "name": "mambot",
  "version": "0.0.1",
  "description": "a discord bot",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "check": "biome check --unsafe --write",
    "check-updates": "pnpx npm-check-updates -ui && pnpx @biomejs/biome migrate --write",
    "dev": "tsx watch --env-file ./.env src/index.ts",
    "prepare": "husky",
    "register-commands": "tsx --env-file ./.env src/scripts/register-commands.ts",
    "start": "node ./dist/index.js"
  },
  "author": "Marviuz",
  "license": "MIT",
  "lint-staged": {
    "*": "biome check --write --unsafe --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "bufferutil": "^4.1.0",
    "cron": "^4.4.0",
    "discord.js": "^14.26.4",
    "pino": "^10.3.1",
    "zlib-sync": "^0.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.6",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.5.0"
}
